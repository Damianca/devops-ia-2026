# Comando para ejecutar el contenedor con el index.html 

docker run -d \
  -p 8080:80 \
  -v /home/maxiperlo/devops-ia-2026/ejemplo3:/usr/share/nginx/html \
  --name servidor_web \
  nginx

# -p Para seleccionar el puerto host 8080, 80 el puerto dentro del contenedor 
# -v para el volumen, que mapea mi ruta local /home/maxiperlo/devops-ia-2026/ejemplo3 a la ruta dentro del contenedor 
# :/usr/share/nginx/htnl 
# --name para establecer el nombre del contenedor 
# nginx actua como servidor web  
